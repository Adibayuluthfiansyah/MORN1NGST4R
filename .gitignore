# MORN1NGST4R .gitignore
#
# Policy (decision D-84, docs/decisions/0003-foundation-closure-decisions.md):
#   * Secrets, local configuration, runtime data, assessment evidence, generated output and
#     third-party skill payloads never enter Git.
#   * Patterns are anchored to the repository root wherever a bare name could match a legitimate
#     source directory (for example internal/domain/evidence, internal/domain/job, app/build).
#   * Adding a pattern here does not untrack a file that Git already tracks. Check with
#     `git ls-files -ci --exclude-standard` and run `python3 scripts/validate-foundation.py`.
#   * Verify any new rule with `git check-ignore -v <path>`.

# === 1. Third-party agent skill payload and agent workflow state (local, reproducible) =========
# ~44 MB of unmodified upstream skills installed by scripts/sync-agent-skills.sh.
# Pins live in that script. Recreate with: scripts/sync-agent-skills.sh install
# Project-owned .kiro/steering/, .kiro/specs/, .kiro/hooks/ and .kiro/agents/ stay tracked.
.kiro/skills/
# Generated by the sync script (content hashes of the local payload). Not a source of truth.
.kiro/skills-lock.json
# Kiro user and workspace settings can hold MCP server tokens. Local only.
.kiro/settings/
# Superpowers subagent-driven-development ledgers and brainstorming visual companion files.
.superpowers/
# Git worktrees created by the using-git-worktrees skill.
.worktrees/
# Taste skill build and checker state (only created when its scripts run).
.taste-skill/

# === 2. Secrets, credentials and local configuration (security.md section 6) ====================
.env
.env.*
*.env
.envrc
# Placeholders only. These are meant to be committed.
!.env.example
!.env.*.example
# Local overrides of any configuration file (DSNs, provider endpoints, local ports).
*.local
*.local.json
*.local.yaml
*.local.yml
*.local.toml
*.local.env
/config/local/
# Private keys, certificates with private material, keystores, password stores.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ppk
*.gpg
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
!*.pub
# Credential, token and secret files and directories.
.secrets/
/secrets/
/secret/
/credentials/
credentials.json
credentials.yaml
credentials.yml
*.credentials
token.json
*.token
.netrc
_netrc
service-account*.json
# Authentication cookies and browser session exports (target sessions included).
cookies.txt
cookies.sqlite
*.cookies
cookie-jar*
storage-state.json
/playwright/.auth/
session-export*
# Database dumps and local database files can hold secrets and target data.
*.dump
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst
pg_dump*
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# === 3. Runtime data, assessment evidence and captured traffic ================================
# Planned local runtime data directory (structure.md section 3, P-62). Root only, so a source
# directory named data/ inside a package is not hidden.
/data/
/.morningstar/
/morningstar-data/
# Local PostgreSQL clusters and per-user data directories created for development.
/pgdata/
/postgres-data/
/pg_data/
.pgdata/
# Assessment workspaces, local evidence stores, generated reports and exports (root only).
/evidence/
/evidence-store/
/workspaces/
/jobs/
/reports/
/exports/
/output/
/outputs/
/results/
/scans/
/recon/
/screenshots/
Screenshot*.png
Screen Shot*.png
# Request and response captures, traffic dumps, raw scanner output.
*.har
*.pcap
*.pcapng
*.cap
*.saz
*.nmap
*.gnmap
*.xnmap
nuclei-output*
httpx-output*
subfinder-output*
# Downloaded tool templates and tool caches. Pinned by digest, never committed.
/nuclei-templates/
/.tools/
# Application, audit and tool logs.
*.log
*.log.*
/logs/
# Spike evidence that the feasibility documents cite is intentionally tracked.
!scripts/spikes/*/last-run/*.log
# Crash dumps and temporary files.
*.core
core.[0-9]*
*.dmp
hs_err_pid*
*.tmp
*.temp
/tmp/
/temp/
.tmp/
# Process, socket and lock state of local services.
*.pid
*.sock
*.socket

# === 4. Generated build, test and cache output =================================================
# Go. Never ignore go.mod, go.sum or testdata/fuzz (a failing fuzz input is committed on purpose).
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.coverprofile
*.cover
*.lcov
coverage.out
coverage.txt
coverage.html
coverage.xml
coverage.json
cover.out
*.prof
*.pprof
*.trace
*.cpuprofile
*.heapsnapshot
__debug_bin*
go.work
go.work.sum
/bin/
/services/core/bin/
/services/core/tmp/
# Frontend (Next.js, npm). Never ignore package.json, package-lock.json or tsconfig.json.
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/install-state.gz
/apps/web/.next/
/apps/web/out/
/apps/web/build/
/apps/web/dist/
/apps/web/coverage/
/apps/web/next-env.d.ts
/packages/*/dist/
/packages/*/build/
/packages/*/coverage/
.turbo/
.vercel/
*.tsbuildinfo
.eslintcache
.stylelintcache
/playwright-report/
/test-results/
/blob-report/
/apps/web/playwright-report/
/apps/web/test-results/
storybook-static/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Repository-level build output.
/dist/
/build/
/out/
/coverage/
.cache/
# Python (spike scripts, tooling).
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# Benchmarks and local profiling output.
*.bench
bench*.out

